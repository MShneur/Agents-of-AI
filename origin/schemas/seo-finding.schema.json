{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeoFinding",
  "type": "object",
  "required": ["id","category","issue","impact","evidence","detection_method","exact_fix","effort","priority","owner_persona","verification_test"],
  "properties": {
    "id":{"type":"string"},"category":{"type":"string"},"issue":{"type":"string"},
    "impact":{"enum":["high","medium","low"]},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["artifact"],"properties":{"artifact":{"type":"string"},"excerpt":{"type":"string"},"checked_at":{"type":["string","null"]}}}},
    "detection_method":{"type":"string"},"exact_fix":{"type":"string"},
    "effort":{"enum":["small","medium","large"]},"priority":{"type":"integer","minimum":1},
    "owner_persona":{"type":"string"},"verification_test":{"type":"string"}
  },"additionalProperties":false
}