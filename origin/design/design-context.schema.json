{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "page",
    "implementation",
    "available_components",
    "data_contracts",
    "required_states",
    "trust_requirements",
    "responsive_targets"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "page": {
      "type": "object",
      "required": [
        "route",
        "page_type",
        "primary_user_goal",
        "primary_action"
      ],
      "properties": {
        "route": {
          "type": "string"
        },
        "page_type": {
          "type": "string"
        },
        "primary_user_goal": {
          "type": "string",
          "minLength": 1
        },
        "primary_action": {
          "type": "string",
          "minLength": 1
        },
        "secondary_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": [
        "framework",
        "language",
        "styling",
        "components",
        "test_stack"
      ]
    },
    "available_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "trust_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsive_targets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "width"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 240
          }
        }
      }
    }
  }
}