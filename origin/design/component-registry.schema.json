{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "version",
    "components"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "owner",
          "required_states",
          "required_tests",
          "data_contract"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "approved",
              "deprecated"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "required_states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "data_contract": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}